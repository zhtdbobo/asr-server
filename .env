# 云桌面直接运行主 API（8010），远程 GPU 服务器提供 ASR 8001 / 说话人 8002。
# 使用截图中已验证可访问的 ASR 接口。
ASR_API_URL=http://10.130.1.6:8001/v1/audio/transcriptions
# 留空时自动读取 /v1/models 的唯一模型 ID；也可填写 Postman 中成功使用的完整 model。
# 注意：现有服务可能使用本地模型路径作为 ID，不一定是 Qwen/Qwen3-ASR-1.7B。
ASR_MODEL=
ASR_API_KEY=

# 留空表示无需鉴权；如需鉴权可自行设置。
SERVICE_API_KEY=
# 若启用鉴权，此值必须与服务器 .env.gpu 中的 INTERNAL_API_KEY 相同。
INTERNAL_API_KEY=

# 云桌面通过服务器 IP 访问说话人 GPU 容器映射出来的端口。
DIARIZATION_API_URL=http://10.130.1.6:8002/v1/diarization

# 主 API 的队列与结果存放在云桌面项目目录下的 ./outputs/jobs。
JOB_DIRECTORY=outputs/jobs
JOB_WORKERS=2
MAX_PENDING_JOBS=100
