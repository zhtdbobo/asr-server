# 复制为服务器上的 .env.gpu，供 compose.yaml 的说话人 GPU 服务使用。
# 启动：docker compose --env-file .env.gpu up -d --no-build --pull never

# 若启用鉴权，必须与云桌面 .env 中的 INTERNAL_API_KEY 相同。
INTERNAL_API_KEY=

# 服务器 ./models 挂载到容器 /models；只读取完整的本地模型。
DIARIZATION_MODEL=/models/speaker-diarization-community-1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 示例假设 ASR 占用物理 GPU 0，请按服务器实际卡号修改。
DIARIZATION_GPU_ID=1
DIARIZATION_DEVICE=cuda:0
