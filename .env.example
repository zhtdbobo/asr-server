# 现有 Qwen3-ASR 文件上传接口，必须包含完整路径。
# 主 API 运行在云桌面，ASR 和说话人服务运行在远程服务器；按实际情况修改服务器 IP。
ASR_API_URL=http://10.130.1.6:8001/v1/audio/transcriptions
# 留空时自动读取 /v1/models 的唯一模型 ID；多模型服务请明确填写对应 id。
# 必须与现有 ASR API 接受的 model 完全一致，可能是 /data/... 本地模型路径。
ASR_MODEL=
ASR_API_KEY=
# ASR 的每块生成上限与等待上限；文本截断时自动缩短音频重新识别。
ASR_MAX_COMPLETION_TOKENS=1024
ASR_TIMEOUT_SECONDS=90

# 对外入口用 SERVICE_API_KEY；说话人服务使用 INTERNAL_API_KEY，可按需设置。
SERVICE_API_KEY=
# 若启用鉴权，此值必须与服务器 .env.gpu 中的 INTERNAL_API_KEY 相同。
INTERNAL_API_KEY=
DIARIZATION_API_URL=http://10.130.1.6:8002/v1/diarization

# API 默认使用 firered-nemotron。两条 URL 均填写完整接口路径。
DEFAULT_BACKEND=firered-nemotron
FIRERED_ASR_API_URL=
FIRERED_ASR_MODEL=
FIRERED_ASR_API_KEY=
NEMOTRON_DIARIZATION_API_URL=
NEMOTRON_API_KEY=

# 云桌面的单进程队列；同一目录只能由一个 API 进程管理。
JOB_WORKERS=2
MAX_PENDING_JOBS=100
JOB_DIRECTORY=outputs/jobs
# 每个说话人片段超过此长度时细分，再合并回段落；时间戳沿用说话人分段。
ASR_CHUNK_SECONDS=30
# 每个文件内部的 ASR 分块并发数；批处理可用 --asr-workers 覆盖。
# 文件并发数 × 此值即本进程最多同时发出的 ASR 请求数，请按服务容量设置。
ASR_WORKERS=1
# 超时、合并间隔、上传大小等使用 config.py 默认值，可按需添加覆盖。

# MOSS 独立批处理使用以下配置，不使用上面的 ASR/DIARIZATION 配置。
MOSS_API_URL=http://127.0.0.1:8000/v1/audio/transcriptions
MOSS_MODEL=moss-mtd
MOSS_API_KEY=
# 服务端创建容器时设置 VLLM_MAX_AUDIO_CLIP_FILESIZE_MB=500，与脚本默认上限一致。
