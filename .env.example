# 现有 Qwen3-ASR 文件上传接口，必须包含完整路径。
# 主 API 运行在云桌面，三个 GPU 服务运行在远程服务器；按实际情况修改服务器 IP。
ASR_API_URL=http://10.130.1.6:8001/v1/audio/transcriptions
# 留空时自动读取 /v1/models 的唯一模型 ID；多模型服务请明确填写对应 id。
# 必须与现有 ASR API 接受的 model 完全一致，可能是 /data/... 本地模型路径。
ASR_MODEL=
ASR_API_KEY=
# ASR 的每块生成上限与等待上限；文本截断时自动缩短音频重新识别。
ASR_MAX_COMPLETION_TOKENS=1024
ASR_TIMEOUT_SECONDS=90

# 对外入口用 SERVICE_API_KEY；两个内部服务共享 INTERNAL_API_KEY，可按需设置。
SERVICE_API_KEY=
# 若启用鉴权，此值必须与服务器 .env.gpu 中的 INTERNAL_API_KEY 相同。
INTERNAL_API_KEY=
DIARIZATION_API_URL=http://10.130.1.6:8002/v1/diarization
ALIGNER_API_URL=http://10.130.1.6:8003/v1/alignment

# 云桌面的单进程队列；同一目录只能由一个 API 进程管理。
JOB_WORKERS=2
MAX_PENDING_JOBS=100
JOB_DIRECTORY=outputs/jobs
# 超时、分块长度、合并间隔、上传大小等使用 config.py 默认值，可按需添加覆盖。
