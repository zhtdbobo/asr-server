# FireRedASR2(ASR) + Nemotron-3-Diarization 批处理配置
# 本文件存在时会被 batch_transcribe_nemotron.py 优先加载（override=True）。

# ===== ASR：FireRedASR2-AED（普通 JSON，已带标点）=====
ASR_API_URL=http://127.0.0.1:8004/v1/audio/transcriptions
ASR_MODEL=fireredasr2
ASR_API_KEY=

# ===== 说话人分离：Nemotron-3-Diarization（segments 格式）=====
DIARIZATION_API_URL=http://127.0.0.1:8006/v1/audio/diarizations
INTERNAL_API_KEY=

# ===== 批处理参数 =====
ASR_CHUNK_SECONDS=30
ASR_WORKERS=1
JOB_WORKERS=1
API_TIMEOUT_SECONDS=600
ASR_TIMEOUT_SECONDS=120
