# docker run --env-file .env.api
# 容器启动前，将 URL 中的 127.0.0.1 换成容器可访问的推理服务地址。
DEFAULT_BACKEND=firered-nemotron

# FireRed + Nemotron（来自 .env.nemotron）
FIRERED_ASR_API_URL=http://127.0.0.1:8004/v1/audio/transcriptions
FIRERED_ASR_MODEL=fireredasr2
FIRERED_ASR_API_KEY=
NEMOTRON_DIARIZATION_API_URL=http://127.0.0.1:8006/v1/audio/diarizations
NEMOTRON_API_KEY=

# Qwen + Community-1（来自 .env）
ASR_API_URL=http://127.0.0.1:8001/v1/audio/transcriptions
ASR_MODEL=
ASR_API_KEY=
DIARIZATION_API_URL=http://127.0.0.1:8002/v1/diarization
INTERNAL_API_KEY=

# API 鉴权和任务队列
SERVICE_API_KEY=
JOB_DIRECTORY=outputs/jobs
JOB_WORKERS=2
MAX_PENDING_JOBS=100
