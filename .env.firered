# FireRedASR2 批处理配置（batch_transcribe_firered.py 专用）
# 本文件存在时会被 batch_transcribe_firered.py 优先加载（override=True）。

# ===== ASR：FireRedASR2-AED 服务 =====
# 注意：必须是 /v1/audio/transcriptions 的完整地址
ASR_API_URL=http://127.0.0.1:8004/v1/audio/transcriptions
# FireRedASR2 服务没有 /v1/models，必须显式填写模型名（任意字符串，服务不校验）
ASR_MODEL=fireredasr2
ASR_API_KEY=

# ===== 说话人分离：Community-1 服务（你本地启动的那个） =====
DIARIZATION_API_URL=http://127.0.0.1:8002/v1/diarization
# 若说话人服务启用鉴权，则与服务器 .env.gpu 中 INTERNAL_API_KEY 相同；否则留空
INTERNAL_API_KEY=

# ===== 批处理参数 =====
# FireRedASR2-AED 单条建议 <=60s，分块默认 30s 较安全
ASR_CHUNK_SECONDS=30
ASR_WORKERS=1
JOB_WORKERS=2
API_TIMEOUT_SECONDS=600
# AED 模型单块推理通常很快，90s 足够；显存小/首次加载可调大
ASR_TIMEOUT_SECONDS=120
